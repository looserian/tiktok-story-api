# ──────────────────────────────────────────────────────────────────────────────
# TikTok Story API — Environment Configuration
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# Required: comma-separated list of valid API keys.
# Clients supply one of these via X-API-Key header or Authorization: Bearer.
# Example: API_KEYS=key1,key2,key3
API_KEYS=your-secret-key-here

# Optional: Python logging level. Default: INFO.
# Valid values: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
